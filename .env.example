# Copy to .env.local (not committed). Both values are in Supabase → Project Settings → API.
# The anon key is meant to be public; the database rules in supabase/schema.sql are what protect each person's row.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Push notifications (optional). Generate a key pair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is safe in the app (and needed at build time). The other three values are SERVER-ONLY: set them in Vercel,
# never in a VITE_ variable, and never commit them. See "Push notifications" in README.md.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
# VAPID_PRIVATE_KEY=...            (Vercel only)
# VAPID_SUBJECT=mailto:you@example.com   (Vercel only)
# SUPABASE_SERVICE_ROLE_KEY=...    (Vercel only. Supabase -> Project Settings -> API -> service_role. Bypasses all row rules, so keep it secret.)
# CRON_SECRET=...                  (Vercel only. A long random string; the same value goes in supabase/push.sql.)
